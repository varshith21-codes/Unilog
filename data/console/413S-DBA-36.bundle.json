    "cross_field_rules": [
      {
        "id": "R_GLAZED_UNIT_STATES_HANDING",
        "expr": "glazing_package is null or handing is not null",
        "severity": "error",
        "message": "A glazed unit was captured with no handing. Handing is carried by a single trailing letter on the size code rather than by any word in the description, so a missing value here almost always means the code was not read rather than that the unit is non-handed. It is the most expensive ordering error in the category: the opening is cut before the mistake is found.",
        "references": [
          "glazing_package",
          "handing"
        ]
      }
    ],
