        "id": "R_FAN_STATES_ITS_SPAN",
        "expr": "blade_span is not null",
        "severity": "error",
        "message": "No blade span was captured. It is the only specification most fan descriptions contain and the figure the fan is selected on, because it has to suit the room's area and the clearance from the walls. Two SKUs of the same fan differ by nothing else.",
        "references": [
          "blade_span"
        ]
      },
