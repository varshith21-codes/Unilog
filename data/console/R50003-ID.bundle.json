        "code": "wire_gauge",
        "requirement": "required",
        "weight": 3.0,
        "name": "Wire Gauge",
        "datatype": "string",
        "description": "Conductor size designation exactly as written. A string because three grammars share this column: \"12-4\" is 12 AWG with 4 conductors, \"16/3\" is 16 AWG with 3, and \"4/0\" is a single aught-size conductor. AWG is also inverse \u2014 12 is thicker than 16 \u2014 so a bare number would make any comparison rule read backwards.\n",
        "canonical_unit": null,
        "display_preference": null,
        "quantity_kind": null,
        "multivalued": false,
        "compliance_claim": false,
        "evidence_requirement": "standard",
