    "cross_field_rules": [
      {
        "id": "R_EYEWEAR_STATES_ITS_LENS",
        "expr": "lens_treatment is not null",
        "severity": "error",
        "message": "No lens treatment was captured. It is the fit-for-purpose fact for eye protection: a smoke lens is unusable indoors and a clear one is unusable in glare, and the model name alone does not distinguish them \u2014 Edge sells the same frame in five lens options.",
        "references": [
          "lens_treatment"
        ]
      },
      {
        "id": "R_FRAME_COLOUR_IS_NOT_A_LENS",
        "expr": "finish_color is null or lens_treatment is not null",
        "severity": "warning",
        "message": "A frame colour was captured with no lens treatment, from a description that states them four words apart. Usually means both tokens were read into the colour field, which loses the specification that decides where the eyewear can be worn.",
        "references": [
          "finish_color",
          "lens_treatment"
        ]
      }
    ],
