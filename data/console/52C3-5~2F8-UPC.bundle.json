    "cross_field_rules": [
      {
        "id": "R_LOADCENTER_STATES_AN_AMPERAGE",
        "expr": "enclosure_form != 'Load Center' or amperage_rating is not null",
        "severity": "error",
        "message": "A load centre was captured with no main amperage. It is the figure the panel is specified, permitted and priced on, and it is stated in every load-centre description in this catalogue \u2014 so a missing value means it was not read rather than that it is unrated.",
        "references": [
          "enclosure_form",
          "amperage_rating"
        ]
      },
      {
        "id": "R_BOX_HAS_NO_CIRCUIT_COUNT",
        "expr": "circuit_capacity is null or enclosure_form == 'Load Center'",
        "severity": "warning",
        "message": "A circuit capacity was recorded against something that is not a load centre. A junction or device box holds conductors, not breakers, so this usually means a gang count or a dimension was read into the wrong field.",
        "references": [
          "circuit_capacity",
          "enclosure_form"
        ]
      }
