    "cross_field_rules": [
      {
        "id": "R_NEMA_AGREES_WITH_RATINGS",
        "expr": "nema_configuration is null or (amperage_rating is not null and voltage_rating is not null)",
        "severity": "warning",
        "message": "A NEMA configuration was captured without the amperage and voltage it encodes. The code fixes both \u2014 5-15R is 15 A at 125 V, 6-50R is 50 A at 250 V \u2014 so the two ratings should be present and consistent with it. Deliberately a warning rather than a derivation: expanding the code into the ratings would publish a lookup as though it were a reading.",
        "references": [
          "nema_configuration",
          "amperage_rating",
          "voltage_rating"
        ]
      },
      {
        "id": "R_PLATE_HAS_NO_RATING",
        "expr": "wiring_device_type != 'Wall Plate' or amperage_rating is null",
        "severity": "warning",
        "message": "An amperage rating was recorded against a wall plate, which carries no current and has none. Usually means a rating was inherited from an adjacent device row.",
        "references": [
          "wiring_device_type",
          "amperage_rating"
        ]
      }
    ],
