    "cross_field_rules": [
      {
        "id": "R_GAS_APPLIANCE_IS_NOT_240V",
        "expr": "fuel_type not in ('Gas (Natural)', 'Gas (Propane)') or voltage_rating is null or voltage_rating <= 130",
        "severity": "warning",
        "message": "A gas appliance was captured with a 240 V supply. Gas ranges need only a 120 V circuit for ignition and controls, so a 240 V figure usually means a rating was inherited from an adjacent electric row \u2014 and it would send an installer to run the wrong circuit.",
        "references": [
          "fuel_type",
          "voltage_rating"
        ]
      },
      {
        "id": "R_ELECTRIC_RANGE_STATES_A_VOLTAGE",
        "expr": "fuel_type != 'Electric' or voltage_rating is not null",
        "severity": "warning",
        "message": "An electric cooking appliance was captured with no supply voltage. It is the figure the installer sizes the circuit from, and the difference between 120 V and 240 V decides whether the existing one will do.",
        "references": [
          "fuel_type",
          "voltage_rating"
        ]
      }
    ],
