    "cross_field_rules": [
      {
        "id": "R_HEIGHT_ORDER",
        "expr": "maximum_height >= minimum_height",
        "severity": "warning",
        "message": "Maximum installed height is below the minimum. Usually means the two were read from adjacent table cells in the wrong order. A warning rather than an error because both are strings that may carry per-component qualifiers (\"8-1/2 in Upper Rack, 11-1/4 in Lower Rack\"), so a comparison is not always meaningful and must not block publication.",
        "references": [
          "minimum_height",
          "maximum_height"
        ]
      },
      {
        "id": "R_DOOR_DEPTH_EXCEEDS_BODY",
        "expr": "depth_with_door_open > 0",
        "severity": "warning",
        "message": "Depth with the door open must be positive, and should exceed the cabinet depth. A figure smaller than the body depth means the cabinet dimension was captured instead of the clearance dimension \u2014 the single most consequential error in this class, because it is the number an installer plans the run against.",
        "references": [
          "depth_with_door_open"
        ]
      }
    ],
