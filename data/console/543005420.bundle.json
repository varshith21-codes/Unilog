      },
      {
        "code": "nominal_length",
        "requirement": "required",
        "weight": 3.0,
        "name": "Nominal Length",
        "datatype": "dimension",
        "description": "Overall length as the manufacturer designates it, for tubes, strips and linear fixtures. A designation rather than a measurement: a nominal 4' fluorescent tube is 47-3/4\" so that it fits a 4' fixture, and recording the measured figure would contradict every catalogue.\n",
        "canonical_unit": "mm",
        "display_preference": "imperial_fraction",
        "quantity_kind": "length",
        "multivalued": false,
        "compliance_claim": false,
        "evidence_requirement": "standard",
        "example_values": [
