        "plausible_range": [
          10.0,
          25000.0
        ]
      },
      {
        "code": "edge_profile",
        "requirement": "required",
        "weight": 3.0,
        "name": "Edge Profile",
        "datatype": "enum",
        "description": "How the long edges of a board are machined, which decides the fastening system. A grooved board takes hidden fasteners and needs them; a square-edge board must be face-screwed. They are not interchangeable on the same deck frame.\n",
        "canonical_unit": null,
        "display_preference": null,
        "quantity_kind": null,
        "multivalued": false,
        "compliance_claim": false,
        "evidence_requirement": "standard",
