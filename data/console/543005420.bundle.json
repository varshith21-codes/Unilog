      {
        "code": "nominal_dimensions",
        "requirement": "required",
        "weight": 3.0,
        "name": "Nominal Dimensions",
        "datatype": "string",
        "description": "The trade size designation of a board, post or panel, recorded verbatim. A string rather than a measurement because a nominal 1x6 deck board actually measures about 0.94\" x 5.5\": the designation names a size class and converting it would publish numbers that are false.\n",
        "canonical_unit": null,
        "display_preference": null,
        "quantity_kind": null,
        "multivalued": false,
        "compliance_claim": false,
        "evidence_requirement": "standard",
