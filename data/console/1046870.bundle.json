        "code": "voltage_rating",
        "requirement": "optional",
        "weight": 2.0,
        "name": "Voltage Rating",
        "datatype": "quantity",
        "description": "Nominal supply voltage the appliance is designed to operate on. Read the nameplate or electrical-specification row, not the motor or component rating, which may differ.\n",
        "canonical_unit": "V",
        "display_preference": null,
        "quantity_kind": "voltage",
        "multivalued": false,
        "compliance_claim": false,
