      {
        "code": "mounting_type",
        "requirement": "recommended",
        "weight": 2.0,
        "name": "Mounting Type",
        "datatype": "string",
        "description": "How the appliance is secured in the installation, e.g. leg-levelled, built-in under a counter, or free-standing. Determines what cabinetry work an installation needs, so it is a fitment attribute. Becomes an enum when the LOV supplies the permitted values.\n",
        "canonical_unit": null,
        "display_preference": null,
        "quantity_kind": null,
        "multivalued": false,
        "compliance_claim": false,
        "evidence_requirement": "standard",
