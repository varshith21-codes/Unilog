        "weight": 1.0,
        "name": "Color",
        "datatype": "string",
        "description": "Finish or colourway as the manufacturer names it. A merchandising attribute: buyers filter on it heavily, and the manufacturer's own name for a finish is what shoppers search, so it is recorded verbatim rather than mapped to a generic colour.\n",
        "canonical_unit": null,
        "display_preference": null,
