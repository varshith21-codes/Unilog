      {
        "code": "model_number",
        "requirement": "optional",
        "weight": 1.0,
        "name": "Model",
        "datatype": "string",
        "description": "The manufacturer's marketing model designation where it differs from the ordering part number. Often absent, or identical to the MPN and therefore not restated by the manufacturer, which is why the ground truth leaves it blank.\n",
        "canonical_unit": null,
        "display_preference": null,
        "quantity_kind": null,
