        "code": "extinguisher_rating",
        "requirement": "optional",
        "weight": 3.0,
        "name": "UL Rating",
        "datatype": "string",
        "description": "The UL fire rating of an extinguisher, such as 2A:10B:C. A string because it is a compound code rather than a magnitude: the number before A is a water-equivalent size, the number before B is a square-foot area, and C is a bare suitability flag with no number at all.\n",
        "canonical_unit": null,
        "display_preference": null,
        "quantity_kind": null,
        "multivalued": false,
        "compliance_claim": false,
        "evidence_requirement": "standard",
