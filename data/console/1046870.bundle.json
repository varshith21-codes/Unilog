    "cross_field_rules": [
      {
        "id": "R_ALARM_STATES_WHAT_IT_DETECTS",
        "expr": "detection_type is not null or extinguisher_rating is not null",
        "severity": "error",
        "message": "A life-safety device was captured stating neither what it detects nor a UL fire rating. One or the other is the entire purpose of the product, and a blank here is the only gap in this schema that could contribute to physical harm rather than to a bad purchase.",
        "references": [
          "detection_type",
          "extinguisher_rating"
        ]
      },
      {
        "id": "R_EXTINGUISHER_IS_NOT_A_DETECTOR",
        "expr": "extinguisher_rating is null or detection_type is null",
        "severity": "warning",
        "message": "Both a UL fire rating and a detection type were captured for one product. Extinguishers suppress and alarms detect; a device recorded as doing both usually means values were merged across two adjacent rows.",
        "references": [
          "extinguisher_rating",
          "detection_type"
        ]
      }
    ],
