# Copy this file to .env.deploy and replace every deployment-specific value.
# Start with: docker compose --env-file .env.deploy up -d --build

# One canonical browser/proxy origin, with scheme and no trailing slash.
# Local HOST-ONLY smoke test: http://localhost (Basic Auth is cleartext over HTTP).
# Production: https://axiom.example.com (Caddy obtains and renews TLS automatically).
# This is compiled into the Next.js image, so changing it requires a console rebuild.
AXIOM_ORIGIN=http://localhost

# Every public route is protected until application-level identity is added.
AXIOM_AUTH_USER=axiom
# Generate with:
# docker run --rm caddy:2.10.2-alpine caddy hash-password --plaintext "use-a-long-random-password"
# Keep the single quotes: bcrypt hashes contain '$', which Compose otherwise interpolates.
AXIOM_AUTH_HASH='$2a$14$REPLACE_WITH_A_REAL_CADDY_HASH'

# Use an absolute EBS-backed path on EC2, for example /srv/axiom/data.
AXIOM_DATA_DIR=./data

# The configured Bedrock model cascade is available in us-east-2 for this project.
AWS_DEFAULT_REGION=us-east-2

# `auto` prefers Serper when a key is present and otherwise falls back to DuckDuckGo.
# Search results are candidate URLs only; source pages/documents are fetched and verified before use.
AXIOM_SEARCH=auto
# Optional but recommended for production-scale discovery. Leave blank to use DuckDuckGo.
AXIOM_SERPER_API_KEY=

# Render JavaScript product pages only after static retrieval fails SKU coverage.
# The API image includes the pinned Playwright Chromium runtime.
AXIOM_BROWSER=auto
