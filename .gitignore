.env
.env.*
*.pem
*.key
credentials
aws-exports.js

# --- python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# --- node / cdk ---
node_modules/
cdk.out/
*.tsbuildinfo
.cdk.staging/

