# --- secrets: never commit ---
.env
.env.*
*.pem
*.key
credentials
aws-exports.js

# --- python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# --- node / cdk ---
node_modules/
cdk.out/
*.tsbuildinfo
.cdk.staging/

# --- next.js console ---
.next/
next-env.d.ts
apps/console/src/data/fixture.json

# --- local data: large binaries and scratch ---
data/samples/**/*.pdf
data/samples/**/*.png
data/samples/**/*.jpg
data/cache/
evals/results/*.local.json

# Per-run backtest output. evals/baseline.json IS committed — it is the regression gate's
# reference point, and a gate whose baseline is not in version control cannot be reviewed.
evals/candidate.json

# Mapped supplier rows are derived output and scale with the feed; the per-supplier column
# mapping beside them is learned state and IS committed, like data/calibration/priors.json.
data/ingest/*.rows.json

# --- os / editor ---
Thumbs.db
Desktop.ini
.DS_Store
.idea/
*.swp
