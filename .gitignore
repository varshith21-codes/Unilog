.next/
next-env.d.ts
apps/console/src/data/fixture.json

# --- local data: large binaries and scratch ---
data/samples/**/*.pdf
data/samples/**/*.png
data/samples/**/*.jpg

# ...except the generated PDF fixture, which is 3 KB and is a test dependency rather than sample
# data. `scripts/make_hard_sample.py` authors it from scratch — there is no vendor content in it and
# nothing to license — and the golden set names it as a source document, so the exclusion above took
# roughly twenty tests down with it on any clone but the one it was generated on. The rule above is
# right for real supplier literature, which is large and not ours to redistribute. This file is
# neither.
!data/samples/ap77c.pdf
data/cache/
evals/results/*.local.json

# Per-run backtest output. evals/baseline.json IS committed — it is the regression gate's
# reference point, and a gate whose baseline is not in version control cannot be reviewed.
evals/candidate.json

# Mapped supplier rows are derived output and scale with the feed; the per-supplier column
# mapping beside them is learned state and IS committed, like data/calibration/priors.json.
data/ingest/*.rows.json

# Per-run delivery output, regenerated by scripts/export_delivery.py. Scales with the feed, and a
# 252-column CSV is not something anyone should review in a diff. What IS committed is the part
# that can be reviewed: the contract it conforms to (schema/delivery/) and the score it earns
# against ground truth (pinned in tests/test_delivery_scoring.py).
data/delivery/

# Per-submission output from POST /api/enrich, on the same principle as data/delivery/ above: one
# 252-column row plus its provenance sidecar and a workbook, written per run. Unlike data/console/
# and data/sessions/ — which are the demo corpus and ARE committed — these are download artifacts
# with no reviewable content, and every one of them cost a real model call to produce.
data/enrich/

